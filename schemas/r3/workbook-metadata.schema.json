{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:implementation-tracker-workbook:r3:0.1.0:workbook-metadata",
  "title": "Workbook metadata",
  "description": "Metadata for one copy of the tracker workbook (WBK). The workbook records it on the README tab. Examples are illustrative examples using synthetic data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workbook_id",
    "workbook_version",
    "r1_commit",
    "shared_standard_version",
    "calculation_as_of_at",
    "org_stage",
    "operating_mode",
    "generated_at"
  ],
  "properties": {
    "workbook_id": {
      "type": "string",
      "pattern": "^WBK-[0-9]{6}$"
    },
    "workbook_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "The R3 workbook version."
    },
    "r1_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The pinned R1 commit the workbook implements."
    },
    "shared_standard_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "calculation_as_of_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Evaluation time for every time-based formula. A user-configurable parameter; no formula reads the clock."
    },
    "event_reconciliation_from_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Material changes at or after this time need an Event Log row. A user-configurable parameter."
    },
    "org_stage": {
      "type": "string",
      "enum": [
        "startup",
        "early_scale",
        "structured_growth",
        "mature"
      ],
      "description": "Selected organization stage (R1 standard/org-stages.yaml)."
    },
    "operating_mode": {
      "type": "string",
      "enum": [
        "starter",
        "full"
      ],
      "description": "Starter Mode or Full Mode. Same workbook and model either way."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the builder generated the workbook (the pinned R1 synchronization time, so builds are reproducible)."
    }
  },
  "examples": [
    {
      "workbook_id": "WBK-000001",
      "workbook_version": "0.1.0",
      "r1_commit": "9acd25a4673facf2b3cca2467142987548949ce3",
      "shared_standard_version": "1.0.0",
      "calculation_as_of_at": "2026-10-05T23:59:59Z",
      "event_reconciliation_from_at": "2026-09-01T00:00:00Z",
      "org_stage": "startup",
      "operating_mode": "starter",
      "generated_at": "2026-10-06T23:21:51Z"
    }
  ]
}
