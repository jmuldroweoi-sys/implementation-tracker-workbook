{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:implementation-operating-system:core:0.1.0:issue",
  "title": "Issue",
  "description": "A problem affecting a project now (ISS). Examples are illustrative examples using synthetic data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id",
    "project_id",
    "phase_id",
    "title",
    "description",
    "severity",
    "status",
    "owner_role_id",
    "opened_at",
    "schema_version"
  ],
  "properties": {
    "issue_id": {
      "type": "string",
      "pattern": "^ISS-[0-9]{6}$",
      "description": "Unique ID of the issue."
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{6}$",
      "description": "Project the issue belongs to."
    },
    "phase_id": {
      "type": "string",
      "pattern": "^PHS-[0-9]{6}$",
      "description": "Phase instance in which the issue was opened; same project."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "Short statement of the problem."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "What is happening and who is affected, by role."
    },
    "severity": {
      "type": "string",
      "enum": [
        "sev1",
        "sev2",
        "sev3",
        "sev4"
      ],
      "description": "Severity value from standard/severity-scale.yaml, which holds the definitions. tools/validate.py checks these values against it."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "description": "Issue status vocabulary, defined here."
    },
    "owner_role_id": {
      "type": "string",
      "pattern": "^ROL-[0-9]{6}$",
      "description": "Role that owns the issue."
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the issue was logged. The severity response timer starts here."
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the issue was resolved. Set when status is resolved or closed."
    },
    "resolution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "How the issue was resolved. Set when status is resolved or closed."
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Version of the R1 core record schemas (0.1.0). Events carry the shared standard version instead."
    }
  },
  "if": {
    "properties": {
      "status": {
        "enum": [
          "resolved",
          "closed"
        ]
      }
    }
  },
  "then": {
    "required": [
      "resolved_at",
      "resolution"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "resolved_at"
          ]
        },
        {
          "required": [
            "resolution"
          ]
        }
      ]
    }
  },
  "x-csv-columns": [
    "issue_id",
    "project_id",
    "phase_id",
    "title",
    "description",
    "severity",
    "status",
    "owner_role_id",
    "opened_at",
    "resolved_at",
    "resolution",
    "schema_version"
  ],
  "examples": [
    {
      "issue_id": "ISS-000004",
      "project_id": "PRJ-000003",
      "phase_id": "PHS-000014",
      "title": "Training environment slow during sessions",
      "description": "Pages load slowly when more than one class uses the training environment.",
      "severity": "sev3",
      "status": "resolved",
      "owner_role_id": "ROL-000004",
      "opened_at": "2026-09-21T14:00:00Z",
      "resolved_at": "2026-09-23T16:00:00Z",
      "resolution": "Classes were moved to separate time slots.",
      "schema_version": "0.1.0"
    }
  ]
}
