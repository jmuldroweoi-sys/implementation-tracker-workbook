{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:implementation-operating-system:core:0.1.0:request",
  "title": "Request",
  "description": "A request for input, approval, or action (REQ) that moves through config/request-state-machine.yaml. Examples are illustrative examples using synthetic data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "project_id",
    "request_type",
    "status",
    "submitted_at",
    "submitted_by_role_id",
    "owner_role_id",
    "priority",
    "status_changed_at",
    "source",
    "description",
    "schema_version"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{6}$",
      "description": "Unique ID of the request."
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{6}$",
      "description": "Project the request belongs to."
    },
    "request_type": {
      "type": "string",
      "enum": [
        "information",
        "access",
        "change",
        "approval",
        "data",
        "training",
        "support"
      ],
      "description": "What kind of help is requested. Defined here."
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "triaged",
        "awaiting_approval",
        "accepted",
        "in_progress",
        "blocked",
        "ready_for_handoff",
        "handed_off",
        "closed"
      ],
      "description": "Must equal the statuses in config/request-state-machine.yaml, which is the authority for statuses and transitions."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the request was submitted."
    },
    "submitted_by_role_id": {
      "type": "string",
      "pattern": "^ROL-[0-9]{6}$",
      "description": "Role that submitted the request."
    },
    "owner_role_id": {
      "type": "string",
      "pattern": "^ROL-[0-9]{6}$",
      "description": "Role that owns the request now."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "description": "Priority set at triage by the owner role. Not a severity."
    },
    "due_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the requester needs the outcome."
    },
    "status_changed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the request entered its current status. SLA timers start here."
    },
    "escalation_due_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Deterministic: status_changed_at plus the target_duration of the enabled config/sla-rules.yaml rule for the current status. Omitted when no rule applies. Never set by AI."
    },
    "source": {
      "type": "string",
      "enum": [
        "customer",
        "internal",
        "partner"
      ],
      "description": "Where the request came from."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "What is requested. Plain operational text; no personal data."
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Version of the R1 core record schemas (0.1.0). Events carry the shared standard version instead."
    }
  },
  "x-csv-columns": [
    "request_id",
    "project_id",
    "request_type",
    "status",
    "submitted_at",
    "submitted_by_role_id",
    "owner_role_id",
    "priority",
    "due_at",
    "status_changed_at",
    "escalation_due_at",
    "source",
    "description",
    "schema_version"
  ],
  "examples": [
    {
      "request_id": "REQ-000002",
      "project_id": "PRJ-000002",
      "request_type": "access",
      "status": "blocked",
      "submitted_at": "2026-09-15T16:00:00Z",
      "submitted_by_role_id": "ROL-000002",
      "owner_role_id": "ROL-000004",
      "priority": "high",
      "due_at": "2026-09-30T17:00:00Z",
      "status_changed_at": "2026-09-24T15:00:00Z",
      "escalation_due_at": "2026-09-26T15:00:00Z",
      "source": "customer",
      "description": "Set up the integration connection to the customer system.",
      "schema_version": "0.1.0"
    }
  ]
}
