{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:implementation-operating-system:core:0.1.0:milestone",
  "title": "Milestone",
  "description": "A dated checkpoint within a project (MLS). R1 records milestones; it does not calculate progress percentages. Examples are illustrative examples using synthetic data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_id",
    "project_id",
    "phase_id",
    "name",
    "status",
    "target_date",
    "critical_flag",
    "owner_role_id",
    "schema_version"
  ],
  "properties": {
    "milestone_id": {
      "type": "string",
      "pattern": "^MLS-[0-9]{6}$",
      "description": "Unique ID of the milestone."
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{6}$",
      "description": "Project the milestone belongs to."
    },
    "phase_id": {
      "type": "string",
      "pattern": "^PHS-[0-9]{6}$",
      "description": "Phase instance the milestone belongs to; same project."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "What the milestone confirms."
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "achieved",
        "missed"
      ],
      "description": "Milestone status vocabulary, defined here. missed is recorded when the target date passes without achievement."
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date the milestone is due."
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Date the milestone was achieved. Set only when status is achieved."
    },
    "critical_flag": {
      "type": "boolean",
      "description": "True when the milestone protects the launch date."
    },
    "owner_role_id": {
      "type": "string",
      "pattern": "^ROL-[0-9]{6}$",
      "description": "Role accountable for the milestone."
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Version of the R1 core record schemas (0.1.0). Events carry the shared standard version instead."
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "achieved"
      }
    }
  },
  "then": {
    "required": [
      "completed_date"
    ]
  },
  "else": {
    "not": {
      "required": [
        "completed_date"
      ]
    }
  },
  "x-csv-columns": [
    "milestone_id",
    "project_id",
    "phase_id",
    "name",
    "status",
    "target_date",
    "completed_date",
    "critical_flag",
    "owner_role_id",
    "schema_version"
  ],
  "examples": [
    {
      "milestone_id": "MLS-000001",
      "project_id": "PRJ-000001",
      "phase_id": "PHS-000001",
      "name": "Kickoff completed",
      "status": "achieved",
      "target_date": "2026-09-11",
      "completed_date": "2026-09-10",
      "critical_flag": true,
      "owner_role_id": "ROL-000001",
      "schema_version": "0.1.0"
    }
  ]
}
