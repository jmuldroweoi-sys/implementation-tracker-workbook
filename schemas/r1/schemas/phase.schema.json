{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:implementation-operating-system:core:0.1.0:phase",
  "title": "Phase instance",
  "description": "One lifecycle phase instance within one project (PHS). A project that returns from validate to build for rework gets a new build instance, so phase history is never overwritten. Examples are illustrative examples using synthetic data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase_id",
    "project_id",
    "lifecycle_phase_key",
    "status",
    "owner_role_id",
    "schema_version"
  ],
  "properties": {
    "phase_id": {
      "type": "string",
      "pattern": "^PHS-[0-9]{6}$",
      "description": "Unique ID of this phase instance within one project."
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{6}$",
      "description": "Project this phase instance belongs to."
    },
    "lifecycle_phase_key": {
      "type": "string",
      "enum": [
        "initiate",
        "discover",
        "design",
        "build",
        "validate",
        "enable",
        "launch",
        "stabilize",
        "transition",
        "review"
      ],
      "description": "Phase key from standard/lifecycle-terms.yaml; also the phase_id in lifecycle/lifecycle.yaml."
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "active",
        "awaiting_gate",
        "completed",
        "blocked"
      ],
      "description": "Phase status from standard/lifecycle-terms.yaml."
    },
    "entered_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the project entered this phase instance."
    },
    "exited_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the project left this phase instance. Set only when status is completed."
    },
    "owner_role_id": {
      "type": "string",
      "pattern": "^ROL-[0-9]{6}$",
      "description": "Role that owns this phase instance."
    },
    "gate_id": {
      "type": "string",
      "pattern": "^[a-z]+_gate$",
      "description": "Gate key from lifecycle/gates.yaml for this phase. Omitted for review, which has no gate."
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Version of the R1 core record schemas (0.1.0). Events carry the shared standard version instead."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "entered_at",
          "exited_at"
        ]
      },
      "else": {
        "not": {
          "required": [
            "exited_at"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "active",
              "awaiting_gate",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "required": [
          "entered_at"
        ]
      }
    }
  ],
  "x-csv-columns": [
    "phase_id",
    "project_id",
    "lifecycle_phase_key",
    "status",
    "entered_at",
    "exited_at",
    "owner_role_id",
    "gate_id",
    "schema_version"
  ],
  "examples": [
    {
      "phase_id": "PHS-000001",
      "project_id": "PRJ-000001",
      "lifecycle_phase_key": "initiate",
      "status": "completed",
      "entered_at": "2026-09-08T14:05:00Z",
      "exited_at": "2026-09-15T16:00:00Z",
      "owner_role_id": "ROL-000001",
      "gate_id": "initiate_gate",
      "schema_version": "0.1.0"
    }
  ]
}
