{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:implementation-operating-system:core:0.1.0:handoff",
  "title": "Handoff",
  "description": "A transfer of responsibility between roles (HND). Acceptance is always recorded by a named person; no handoff is accepted by a rule or an agent. Examples are illustrative examples using synthetic data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_id",
    "project_id",
    "from_role_id",
    "to_role_id",
    "handoff_type",
    "status",
    "required_artifact_refs",
    "requested_at",
    "schema_version"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "pattern": "^HND-[0-9]{6}$",
      "description": "Unique ID of the handoff."
    },
    "project_id": {
      "type": "string",
      "pattern": "^PRJ-[0-9]{6}$",
      "description": "Project the handoff belongs to."
    },
    "from_role_id": {
      "type": "string",
      "pattern": "^ROL-[0-9]{6}$",
      "description": "Role handing over responsibility."
    },
    "to_role_id": {
      "type": "string",
      "pattern": "^ROL-[0-9]{6}$",
      "description": "Role receiving responsibility."
    },
    "handoff_type": {
      "type": "string",
      "enum": [
        "intake",
        "phase",
        "request",
        "transition"
      ],
      "description": "What is being handed over. Defined here."
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "accepted",
        "rejected"
      ],
      "description": "Handoff status vocabulary, defined here. handoff.completed is emitted when status becomes accepted."
    },
    "required_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}-[0-9]{6}$"
      },
      "uniqueItems": true,
      "description": "IDs of the records that must accompany the handoff."
    },
    "open_item_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3}-[0-9]{6}$"
      },
      "uniqueItems": true,
      "description": "IDs of work that stays open after the handoff; each keeps an owner role."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When the handoff was requested. The handoff_acceptance SLA timer starts here."
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "When a named person accepted the handoff."
    },
    "acceptance_person_id": {
      "type": "string",
      "pattern": "^PER-[0-9]{6}$",
      "description": "The named human who accepted the handoff. Required when status is accepted."
    },
    "schema_version": {
      "type": "string",
      "const": "0.1.0",
      "description": "Version of the R1 core record schemas (0.1.0). Events carry the shared standard version instead."
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "accepted"
      }
    }
  },
  "then": {
    "required": [
      "accepted_at",
      "acceptance_person_id"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        {
          "required": [
            "accepted_at"
          ]
        },
        {
          "required": [
            "acceptance_person_id"
          ]
        }
      ]
    }
  },
  "examples": [
    {
      "handoff_id": "HND-000002",
      "project_id": "PRJ-000003",
      "from_role_id": "ROL-000004",
      "to_role_id": "ROL-000006",
      "handoff_type": "request",
      "status": "accepted",
      "required_artifact_refs": [
        "REQ-000006"
      ],
      "open_item_refs": [
        "ISS-000005"
      ],
      "requested_at": "2026-10-02T14:00:00Z",
      "accepted_at": "2026-10-02T17:00:00Z",
      "acceptance_person_id": "PER-000005",
      "schema_version": "0.1.0"
    }
  ]
}
