{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:implementation-operating-system:standard:1.0.0:event",
  "title": "Event",
  "description": "The shared event contract (standard 1.0.0). Every event from every repository uses exactly these ten fields. Audit records are events: before and after values go in payload. event_type must appear in standard/event-catalog.yaml, and payload must contain that entry's required payload fields; the standard validator checks both. Examples are illustrative examples using synthetic data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "actor_id",
    "actor_type",
    "subject_type",
    "subject_id",
    "payload",
    "source_repo",
    "schema_version"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{6}$",
      "description": "Unique ID of this event."
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "Dot-notation event type registered in the event catalog."
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "When the event happened, ISO 8601 in UTC ending in Z."
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[0-9]{6}$",
      "description": "ID of the actor. A person (PER) when actor_type is human, an agent (AGT) when ai_agent, and the registered rule, run, or record that produced the event when system."
    },
    "actor_type": {
      "type": "string",
      "enum": ["human", "system", "ai_agent"]
    },
    "subject_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Entity name of the subject, as registered in standard/id-registry.yaml."
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Z]{3}-[0-9]{6}$",
      "description": "ID of the subject; its prefix must be registered for subject_type."
    },
    "payload": {
      "type": "object",
      "description": "Event-specific fields. Names follow standard/field-conventions.md. Never contains private notes."
    },
    "source_repo": {
      "type": "string",
      "enum": [
        "implementation-operating-system",
        "implementation-capacity-and-org-design",
        "implementation-tracker-workbook",
        "implementation-enablement-program",
        "implementation-team-management-toolkit",
        "implementation-ai-agent-framework"
      ],
      "description": "Repository that produced the event; must equal the catalog producer."
    },
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Version of the shared standard the event conforms to."
    }
  },
  "allOf": [
    {
      "if": {"properties": {"actor_type": {"const": "human"}}},
      "then": {"properties": {"actor_id": {"pattern": "^PER-[0-9]{6}$"}}}
    },
    {
      "if": {"properties": {"actor_type": {"const": "ai_agent"}}},
      "then": {"properties": {"actor_id": {"pattern": "^AGT-[0-9]{6}$"}}}
    }
  ],
  "examples": [
    {
      "event_id": "EVT-000001",
      "event_type": "project.status_changed",
      "occurred_at": "2026-03-02T14:30:00Z",
      "actor_id": "PER-000003",
      "actor_type": "human",
      "subject_type": "project",
      "subject_id": "PRJ-000001",
      "payload": {"from_status": "active", "to_status": "on_hold", "reason": "Customer requested a pause."},
      "source_repo": "implementation-operating-system",
      "schema_version": "1.0.0"
    },
    {
      "event_id": "EVT-000002",
      "event_type": "request.escalated",
      "occurred_at": "2026-03-04T09:00:00Z",
      "actor_id": "RUL-000004",
      "actor_type": "system",
      "subject_type": "request",
      "subject_id": "REQ-000012",
      "payload": {"rule_id": "RUL-000004", "escalation_role_id": "ROL-000002", "severity": "sev2"},
      "source_repo": "implementation-operating-system",
      "schema_version": "1.0.0"
    },
    {
      "event_id": "EVT-000003",
      "event_type": "agent.recommendation_created",
      "occurred_at": "2026-03-06T16:05:00Z",
      "actor_id": "AGT-000001",
      "actor_type": "ai_agent",
      "subject_type": "recommendation",
      "subject_id": "REC-000007",
      "payload": {"task_run_id": "RUN-000010", "agent_id": "AGT-000001"},
      "source_repo": "implementation-ai-agent-framework",
      "schema_version": "1.0.0"
    }
  ]
}
